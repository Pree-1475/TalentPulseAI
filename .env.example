# TalentPulse AI Environment Configuration

# MongoDB Atlas Connection URI
# e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/talentpulse?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/talentpulse

# Firecrawl API Key for Web Crawling and Job Scraping
# Get one at https://firecrawl.dev
FIRECRAWL_API_KEY=

# LLM API Provider Keys (Provide at least one for live AI extraction and insights)
# Google Gemini API Key
GEMINI_API_KEY=
# Or OpenAI API Key
OPENAI_API_KEY=

# Optional Application Configuration
NEXT_PUBLIC_APP_NAME=TalentPulse AI
NEXT_PUBLIC_APP_URL=http://localhost:3000
